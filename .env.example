# ---- App ----
PORT=3000
NODE_ENV=development

# ---- Database (PostgreSQL) ----
# DATABASE_URL is used by the app; DIRECT_URL is used only by `prisma migrate`.
# On a plain Postgres (local docker-compose, CI) they are identical.
DATABASE_URL="postgresql://tappay:tappay@localhost:5434/tappay?schema=public"
DIRECT_URL="postgresql://tappay:tappay@localhost:5434/tappay?schema=public"

# In production the database is Neon (https://neon.tech), not Render. There the two
# differ — DATABASE_URL goes through Neon's PgBouncer pooler, DIRECT_URL bypasses it:
#   DATABASE_URL="postgresql://USER:PASS@ep-xxx-pooler.eu-central-1.aws.neon.tech/tappay?sslmode=require&pgbouncer=true"
#   DIRECT_URL="postgresql://USER:PASS@ep-xxx.eu-central-1.aws.neon.tech/tappay?sslmode=require"

# ---- Firebase Admin ----
# Path to the service account JSON downloaded from the Firebase console.
# (Project settings -> Service accounts -> Generate new private key)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# Alternatively provide the raw JSON in one env var (takes precedence if set):
# FIREBASE_SERVICE_ACCOUNT_JSON=

# ---- Payment session signing ----
# HMAC secret used to sign NFC / QR payment-session payloads (anti-tamper / anti-replay).
SESSION_SIGNING_SECRET=change-me-to-a-long-random-string
# Seconds a payment session stays valid before it expires.
SESSION_TTL_SECONDS=180

# ---- Payment provider ----
# Which implementation settles payments: momo | paystack
PAYMENT_PROVIDER=momo

# ---- Paystack ----
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_BASE_URL=https://api.paystack.co
# Public URL Paystack redirects the customer to after checkout (deep link handled by app).
PAYSTACK_CALLBACK_URL=tappay://payment/callback

# ---- MTN Mobile Money (Ghana) — Collection API ----
# Used when PAYMENT_PROVIDER=momo. Credentials come from https://momodeveloper.mtn.com:
# subscribe to the Collection product, then create an API user + key.
MOMO_SUBSCRIPTION_KEY=
MOMO_API_USER=
MOMO_API_KEY=
# Wallet platform: 'sandbox' for testing, 'mtnghana' for production Ghana.
MOMO_TARGET_ENVIRONMENT=sandbox
# Sandbox: https://sandbox.momodeveloper.mtn.com — production: https://proxy.momoapi.mtn.com
MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
# Optional. MTN only delivers callbacks to the host registered as the API user's
# providerCallbackHost; without one TapPay relies on polling (which it does regardless).
MOMO_CALLBACK_URL=
# Sandbox only: MTN's test platform settles EUR only, so charge in EUR and reconcile the
# result back as the currency TapPay actually booked. Ignored unless the target
# environment is 'sandbox'.
MOMO_SANDBOX_CURRENCY=EUR
MOMO_SANDBOX_AS_CURRENCY=GHS
