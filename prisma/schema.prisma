generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (PgBouncer) — what the running app uses.
  url      = env("DATABASE_URL")
  // Unpooled connection — migrations only. PgBouncer's transaction mode can't hold the
  // advisory locks and session state `prisma migrate` needs, so it must bypass the pooler.
  // On a plain Postgres (local/CI) set this to the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

/// A registered person. Identity is owned by Firebase Auth; we mirror the minimum here.
model User {
  id           String   @id @default(uuid())
  firebaseUid  String   @unique
  email        String?  @unique
  phone        String?  @unique
  displayName  String?
  photoUrl     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  merchant         Merchant?
  devices          Device[]
  sessionsCreated  PaymentSession[] @relation("SessionMerchant")
  paymentsSent     Transaction[]    @relation("TxnPayer")
  paymentsReceived Transaction[]    @relation("TxnPayee")
  notifications    Notification[]
  requestsMade     PaymentRequest[] @relation("RequestRequester")
  requestsReceived PaymentRequest[] @relation("RequestPayer")

  @@index([email])
  @@index([phone])
}

/// A user who can receive payments (individual seller, shop, organization).
model Merchant {
  id           String   @id @default(uuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName String
  category     String?
  currency     String   @default("GHS")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions     PaymentSession[]
  transactions Transaction[]
}

enum SessionChannel {
  NFC
  QR
}

enum SessionStatus {
  PENDING
  CONSUMED
  EXPIRED
  CANCELLED
}

/// A short-lived, signed handshake initiated by a merchant and consumed by a customer.
/// The signed payload is what actually travels over NFC / inside the QR code.
model PaymentSession {
  id          String         @id @default(uuid())
  merchantId  String
  merchant    Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User           @relation("SessionMerchant", fields: [createdById], references: [id])
  amount      Int            // minor units (e.g. pesewas / kobo)
  currency    String         @default("GHS")
  description String?
  channel     SessionChannel @default(NFC)
  status      SessionStatus  @default(PENDING)
  nonce       String         @unique
  signature   String
  expiresAt   DateTime
  createdAt   DateTime       @default(now())

  transaction Transaction?

  @@index([merchantId])
  @@index([status])
}

enum TxnStatus {
  INITIALIZED
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

model Transaction {
  id            String    @id @default(uuid())
  reference     String    @unique // provider reference
  sessionId     String?   @unique
  session       PaymentSession? @relation(fields: [sessionId], references: [id])
  merchantId    String
  merchant      Merchant  @relation(fields: [merchantId], references: [id])
  payerId       String?
  payer         User?     @relation("TxnPayer", fields: [payerId], references: [id])
  payeeId       String
  payee         User      @relation("TxnPayee", fields: [payeeId], references: [id])
  amount        Int       // minor units
  currency      String    @default("GHS")
  provider      String    @default("paystack")
  status        TxnStatus @default(INITIALIZED)
  authorizationUrl String?
  description   String?
  providerMeta  Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([merchantId])
  @@index([payerId])
  @@index([status])
}

enum PaymentRequestStatus {
  PENDING
  PAID
  CANCELLED
  DECLINED
}

/// A targeted, asynchronous "please pay me" addressed to a known user (by email/phone).
/// The requester is the payee (receives money); the payer is asked to settle it, which
/// routes into the existing session -> provider checkout flow. Complements the live
/// NFC/QR session broadcast, which is anonymous and synchronous.
model PaymentRequest {
  id            String               @id @default(uuid())
  requesterId   String
  requester     User                 @relation("RequestRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  payerId       String
  payer         User                 @relation("RequestPayer", fields: [payerId], references: [id], onDelete: Cascade)
  amount        Int                  // minor units (pesewas / kobo)
  currency      String               @default("GHS")
  note          String?
  status        PaymentRequestStatus @default(PENDING)
  // Set once the payer starts checkout; links the request to the settling payment.
  sessionId     String?
  transactionId String?              @unique
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([payerId, status])
  @@index([requesterId, status])
}

model Device {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceId     String   @unique
  platform     String?
  pushToken    String?
  blocked      Boolean  @default(false)
  lastSeenAt   DateTime @default(now())
  createdAt    DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  data      Json?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read])
}

/// Append-only trail of sensitive actions (auth, sessions, payments) for traceability.
/// actorId is stored loosely (no FK) so logs survive even if a user record is removed.
model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  ip         String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
}
